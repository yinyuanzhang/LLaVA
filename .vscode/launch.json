        {
            "name": "Native Method - Read Only",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/llava/eval/model_vqa_loader.py",
            "console": "integratedTerminal",
            "args": [
                "--model-path", "${env:HOME}/.cache/huggingface/hub/llava-v1.5-7b-task-lora-window-16/checkpoint-5500",
                "--model-base", "liuhaotian/llava-v1.5-7b",
