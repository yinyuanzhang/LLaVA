                "--answers-file", "${env:HOME}/autodl-tmp/playground/data/eval/pope/answers/native-read-only.jsonl",
                "--temperature", "0",
                "--conv-mode", "vicuna_v1",
                "--method-type", "native",
                "--cache-mode", "read-only",
                "--dataset", "pope"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "5",
                "LD_LIBRARY_PATH": "",
                "AUTO_DL_TMP": "${env:HOME}/autodl-tmp"
